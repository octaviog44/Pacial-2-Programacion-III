<?xml version="1.0" encoding="UTF-8"?>

<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <persistence-unit name="miUnidad">

        <!-- Provider Hibernate -->
        <provider>
            org.hibernate.jpa.HibernatePersistenceProvider
        </provider>

        <!-- Entidades -->
        <class>com.utn.entities.Categoria</class>
        <class>com.utn.entities.Producto</class>
        <class>com.utn.entities.Usuario</class>
        <class>com.utn.entities.Pedido</class>
        <class>com.utn.entities.DetallePedido</class>

        <properties>

            <!-- Driver -->
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.h2.Driver"/>

            <!-- URL -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:./data/jpa_db"/>

            <!-- Usuario -->
            <property name="jakarta.persistence.jdbc.user"
                      value="sa"/>

            <!-- Password -->
            <property name="jakarta.persistence.jdbc.password"
                      value=""/>

            <!-- Dialecto -->
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.H2Dialect"/>

            <!-- Crear/actualizar tablas automáticamente -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <!-- Mostrar SQL -->
            <property name="hibernate.show_sql"
                      value="true"/>

            <!-- Formatear SQL -->
            <property name="hibernate.format_sql"
                      value="true"/>

            <!-- Resaltar SQL -->
            <property name="hibernate.highlight_sql"
                      value="true"/>

        </properties>

    </persistence-unit>

</persistence>